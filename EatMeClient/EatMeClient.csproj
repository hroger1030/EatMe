<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <MonoGameContentReference Include="Content\Content.mgcb" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\FastG\FastG\FastG.csproj" />
    <ProjectReference Include="..\EatMeLibrary\EatMeLibrary.csproj" />
  </ItemGroup>
  <!-- Publishing zips the built content, music included, into Content\Content.pak -->
  <Target Name="PackContent" AfterTargets="Publish">
    <PropertyGroup>
      <PackContentDir>$(PublishDir)Content\</PackContentDir>
      <PackStagingDir>$(IntermediateOutputPath)ContentPack\</PackStagingDir>
    </PropertyGroup>
    <ItemGroup>
      <PackFiles Include="$(PackContentDir)**\*" Exclude="$(PackContentDir)Content.pak" />
      <PackFolders Include="@(PackFiles->'$(PackContentDir)%(RecursiveDir)')" Condition="'%(PackFiles.RecursiveDir)' != ''" />
    </ItemGroup>
    <RemoveDir Directories="$(PackStagingDir)" />
    <Copy SourceFiles="@(PackFiles)" DestinationFiles="@(PackFiles->'$(PackStagingDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(PackStagingDir)" DestinationFile="$(PackContentDir)Content.pak" Overwrite="true" />
    <Delete Files="@(PackFiles)" />
    <RemoveDir Directories="@(PackFolders->Distinct());$(PackStagingDir)" />
  </Target>
</Project>